// Cloudflare deployment settings. See DEPLOY.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mychessdb",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",

  // Publish at https://mychessdb.<subdomain>.workers.dev, without the extra
  // per-version preview addresses.
  "workers_dev": true,
  "preview_urls": false,

  // The static site. Files in web/ are served as they are; everything else
  // (the /api/* routes) runs worker/index.js.
  "assets": {
    "directory": "./web",
    "binding": "ASSETS"
  },

  // The shared best-move database.
  // Run `npx wrangler d1 create mychessdb` once and paste the id it prints.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mychessdb",
      "database_id": "23b65e1f-0cca-4711-9def-6a6270f2a6c3",
      "migrations_dir": "migrations"
    }
  ],

  // Optional settings (uncomment to change the defaults):
  // "vars": {
  //   "MIN_DEPTH": "21",             // nothing shallower is saved or can be chosen
  //   "FULL_DEPTH": "46",            // depth shown in full colour; shallower saved moves are paler
  //   "ANON_WRITES_PER_HOUR": "600",      // saves per hour for a visitor without a key
  //   "ANON_LIVE_WRITES_PER_HOUR": "500"  // how many of those live analysis may use
  // },

  "observability": { "enabled": true }
}
